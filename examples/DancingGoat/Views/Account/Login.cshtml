@using DancingGoat.Helpers

@model DancingGoat.Models.LoginViewModel

@{
    ViewBag.Title = HtmlLocalizer["Sign in"].Value;
}

<div class="page-head">
    <div class="wrap">
        <h1 class="display">@HeadingFormatter.Format(HtmlLocalizer["Welcome back"].Value)</h1>
    </div>
</div>

<section class="block-tight">
    <div class="wrap">
        <div class="auth-grid">
            <div class="auth-card">
                <h2 class="display">@HeadingFormatter.Format(HtmlLocalizer["Sign in"].Value)</h2>
                <p class="auth-sub">@HtmlLocalizer["Sign in to your Dancing Goat account."]</p>
                <form asp-action="Login" method="post" asp-route-returnUrl="@Context.Request.Query["ReturnUrl"]">
                    @if (ViewData.ModelState.Any(x => x.Value.Errors.Any()))
                    {
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    }
                    @Html.ValidatedEditorFor(model => model.UserName)
                    @Html.ValidatedEditorFor(model => model.Password, includeStorageAttribute: false)
                    <label class="checkbox-row">@Html.EditorFor(model => model.StaySignedIn) <span>@HtmlLocalizer["Stay signed in"]</span></label>
                    <input type="submit" value="@HtmlLocalizer["Sign in"]" class="btn btn-solid btn-block" />
                </form>
            </div>
            <div class="auth-aside">
                <h2 class="display">@HeadingFormatter.Format(HtmlLocalizer["New to Dancing Goat?"].Value)</h2>
                <p>@HtmlLocalizer["It only takes a moment to get started."]</p>
                @Html.ActionLink(HtmlLocalizer["Register"].Value, "Register", null, null, new { @class = "btn btn-outline" })
            </div>
        </div>
    </div>
</section>
