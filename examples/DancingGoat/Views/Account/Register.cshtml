@using DancingGoat.Helpers

@model DancingGoat.Models.RegisterViewModel

@{
    ViewBag.Title = HtmlLocalizer["Register"].Value;
}

<div class="page-head">
    <div class="wrap">
        <h1 class="display">@HeadingFormatter.Format(HtmlLocalizer["Join Dancing Goat"].Value)</h1>
    </div>
</div>

<section class="block-tight">
    <div class="wrap">
        <div class="auth-grid">
            <div class="auth-card">
                <h2 class="display">@HeadingFormatter.Format(HtmlLocalizer["Register"].Value)</h2>
                <p class="auth-sub">@HtmlLocalizer["Create your own account and enjoy smooth shopping experience at Dancing Goat."]</p>
                <form asp-action="Register" method="post">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    @Html.ValidatedEditorFor(model => model.UserName)
                    @Html.ValidatedEditorFor(model => model.Email)
                    @Html.ValidatedEditorFor(model => model.Password, includeStorageAttribute: false)
                    @Html.ValidatedEditorFor(model => model.PasswordConfirmation, includeStorageAttribute: false)

                    <input type="submit" value="@HtmlLocalizer["Register"]" class="btn btn-solid btn-block" />
                </form>
            </div>
            <div class="auth-aside">
                <h2 class="display">@HeadingFormatter.Format(HtmlLocalizer["Already have an account?"].Value)</h2>
                <p>@HtmlLocalizer["Sign in and pick up right where you left off."]</p>
                @Html.ActionLink(HtmlLocalizer["Sign in"].Value, "Login", null, null, new { @class = "btn btn-outline" })
            </div>
        </div>
    </div>
</section>
