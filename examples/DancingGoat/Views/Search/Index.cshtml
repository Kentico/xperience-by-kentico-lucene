@using DancingGoat.Search
@using Kentico.Content.Web.Mvc.Routing

@inject IPreferredLanguageRetriever preferredLanguageRetriever

@model DancingGoatSearchPageViewModel

@{
    Layout = "~/Views/Shared/_DancingGoatLayout.cshtml";
    ViewBag.Title = HtmlLocalizer["Search"].Value;
    var languageName = preferredLanguageRetriever.Get();

    var searchParameters = new Dictionary<string, object>
    {
        [WebPageRoutingOptions.LANGUAGE_ROUTE_VALUE_KEY] = languageName,
        ["query"] = Model.Results.Query,
        ["pageSize"] = Model.Results.PageSize,
        ["facet"] = Model.Results.Facet,
        ["sortBy"] = Model.SortBy
    };
    foreach (var group in Model.FacetGroups)
    {
        searchParameters[group.QueryParameter] = group.SelectedValue;
    }

    string SearchUrl(string parameter, string value)
    {
        var parameters = new Dictionary<string, object>(searchParameters);
        parameters[parameter] = value;
        return Url.RouteUrl(DancingGoatSearchController.SEARCH_ROUTE_NAME, parameters);
    }

    var clearFiltersUrl = Url.RouteUrl(DancingGoatSearchController.SEARCH_ROUTE_NAME, new
    {
        kxpLanguage = languageName,
        query = Model.Results.Query,
        pageSize = Model.Results.PageSize,
        sortBy = Model.SortBy
    });
    var selectedGroups = Model.FacetGroups.Where(group => !string.IsNullOrEmpty(group.SelectedValue)).ToList();
    var activeFilterCount = selectedGroups.Count;
    if (!string.IsNullOrEmpty(Model.Results.Facet))
    {
        activeFilterCount++;
    }
}

<div class="page-head">
    <div class="wrap">
        <h1 class="display">@HtmlLocalizer["Search"]</h1>
        <p class="lede">@HtmlLocalizer["Good coffee starts with a little discovery."]</p>
    </div>
</div>

<section class="block-tight">
    <div class="wrap">
        <form method="get" asp-route="@DancingGoatSearchController.SEARCH_ROUTE_NAME" asp-route-kxpLanguage="@languageName" class="search-form" role="search">
            <div class="search-query">
                <label for="query">@HtmlLocalizer["Search all content"]</label>
                <div class="search-input-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.5 4.5" /></svg>
                    <input class="input" type="search" id="query" name="query" value="@Model.Results.Query" placeholder="@HtmlLocalizer["Coffee, brewing essentials, stories..."]" />
                </div>
                <button class="btn btn-solid" type="submit">@HtmlLocalizer["Search"]</button>
            </div>
            @foreach (var parameter in searchParameters.Where(parameter => parameter.Key != "query" && parameter.Key != WebPageRoutingOptions.LANGUAGE_ROUTE_VALUE_KEY))
            {
                <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
            }
        </form>

        <nav class="search-types" aria-label="@HtmlLocalizer["Content type"]">
            <a class="cat-tab @(string.IsNullOrEmpty(Model.Results.Facet) ? "active" : "")" href="@SearchUrl("facet", null)" aria-current="@(string.IsNullOrEmpty(Model.Results.Facet) ? "true" : null)">@HtmlLocalizer["All content"]</a>
            <a class="cat-tab @(Model.Results.Facet == "Product" ? "active" : "")" href="@SearchUrl("facet", "Product")" aria-current="@(Model.Results.Facet == "Product" ? "true" : null)">@HtmlLocalizer["Products"]</a>
            <a class="cat-tab @(Model.Results.Facet == "Article" ? "active" : "")" href="@SearchUrl("facet", "Article")" aria-current="@(Model.Results.Facet == "Article" ? "true" : null)">@HtmlLocalizer["Articles"]</a>
        </nav>

        <div class="search-layout">
            <aside aria-label="@HtmlLocalizer["Search filters"]">
                <details class="search-filters" open>
                    <summary class="search-filters-heading">
                        <span>@HtmlLocalizer["Filters"]</span>
                        @if (activeFilterCount > 0)
                        {
                            <span class="search-filter-total">@activeFilterCount</span>
                        }
                    </summary>
                    <div class="search-filters-body">
                        @foreach (var facetGroup in Model.FacetGroups)
                        {
                            <details class="search-facet" open="@(facetGroup.QueryParameter == "productCategory" || !string.IsNullOrEmpty(facetGroup.SelectedValue))">
                                <summary>@HtmlLocalizer[facetGroup.Label]</summary>
                                <ul class="search-facet-options" aria-label="@HtmlLocalizer[facetGroup.Label]">
                                    <li>
                                        <a href="@SearchUrl(facetGroup.QueryParameter, null)" aria-current="@(string.IsNullOrEmpty(facetGroup.SelectedValue) ? "true" : null)">
                                            <span class="search-facet-indicator" aria-hidden="true"></span>
                                            <span>@HtmlLocalizer["All"]</span>
                                        </a>
                                    </li>
                                    @foreach (var option in facetGroup.Options)
                                    {
                                        <li>
                                            <a href="@SearchUrl(facetGroup.QueryParameter, option.Value)" aria-current="@(facetGroup.SelectedValue == option.Value ? "true" : null)">
                                                <span class="search-facet-indicator" aria-hidden="true"></span>
                                                <span>@option.Label</span>
                                                <span class="search-facet-count">@option.Count<span class="visually-hidden"> @HtmlLocalizer["results"]</span></span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </details>
                        }
                    </div>
                </details>
            </aside>

            <div class="search-main">
                @if (activeFilterCount > 0)
                {
                    <nav class="search-active-filters" aria-label="@HtmlLocalizer["Active filters"]">
                        @if (!string.IsNullOrEmpty(Model.Results.Facet))
                        {
                            <a class="search-filter-chip" href="@SearchUrl("facet", null)" aria-label="@HtmlLocalizer["Remove filter: {0}", HtmlLocalizer[Model.Results.Facet].Value]">
                                @HtmlLocalizer[Model.Results.Facet]<span aria-hidden="true">&times;</span>
                            </a>
                        }
                        @foreach (var group in selectedGroups)
                        {
                            var label = group.Options.FirstOrDefault(option => option.Value == group.SelectedValue)?.Label ?? group.SelectedValue;
                            <a class="search-filter-chip" href="@SearchUrl(group.QueryParameter, null)" aria-label="@HtmlLocalizer["Remove filter: {0}: {1}", HtmlLocalizer[group.Label].Value, label]">
                                <span>@HtmlLocalizer[group.Label]: @label</span><span aria-hidden="true">&times;</span>
                            </a>
                        }
                        <a class="search-clear" href="@clearFiltersUrl">@HtmlLocalizer["Clear all"]</a>
                    </nav>
                }

                <div class="search-toolbar">
                    <p class="search-count" role="status">
                        @HtmlLocalizer["{0} results", Model.Results.TotalHits]
                    </p>
                    <form method="get" asp-route="@DancingGoatSearchController.SEARCH_ROUTE_NAME" asp-route-kxpLanguage="@languageName" class="search-sort">
                        @foreach (var parameter in searchParameters.Where(parameter => parameter.Key != "sortBy" && parameter.Key != WebPageRoutingOptions.LANGUAGE_ROUTE_VALUE_KEY))
                        {
                            <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
                        }
                        <label for="sortBy">@HtmlLocalizer["Sort by"]</label>
                        <div class="select-wrap">
                            <select class="select" id="sortBy" name="sortBy">
                                <option value="" selected="@(string.IsNullOrEmpty(Model.SortBy))">@HtmlLocalizer["Relevance"]</option>
                                <option value="a-z" selected="@(Model.SortBy == "a-z")">@HtmlLocalizer["Title A-Z"]</option>
                                <option value="z-a" selected="@(Model.SortBy == "z-a")">@HtmlLocalizer["Title Z-A"]</option>
                            </select>
                        </div>
                        <button class="search-sort-apply" type="submit">@HtmlLocalizer["Apply"]</button>
                    </form>
                </div>

                @if (Model.Results.Hits.Any())
                {
                    <div class="search-results">
                        @foreach (var result in Model.Results.Hits)
                        {
                            <article class="search-result">
                                <p class="search-result-type">@HtmlLocalizer[result.ContentType]</p>
                                <h2><a href="@result.Url">@result.Title</a></h2>
                                @if (!string.IsNullOrWhiteSpace(result.SnippetHtml))
                                {
                                    <p class="search-result-snippet">@Html.Raw(result.SnippetHtml)</p>
                                }
                            </article>
                        }
                    </div>

                    @if (Model.Results.TotalPages > 1)
                    {
                        <nav class="search-pagination" aria-label="@HtmlLocalizer["Search result pages"]">
                            @if (Model.Results.Page > 1)
                            {
                                <a class="btn btn-outline" href="@SearchUrl("page", (Model.Results.Page - 1).ToString())">@HtmlLocalizer["Previous"]</a>
                            }
                            <span>@HtmlLocalizer["Page {0} of {1}", Model.Results.Page, Model.Results.TotalPages]</span>
                            @if (Model.Results.Page < Model.Results.TotalPages)
                            {
                                <a class="btn btn-outline" href="@SearchUrl("page", (Model.Results.Page + 1).ToString())">@HtmlLocalizer["Next"]</a>
                            }
                        </nav>
                    }
                }
                else
                {
                    <div class="search-empty">
                        <h2>@HtmlLocalizer["No results found."]</h2>
                        <p>@HtmlLocalizer["Try a different search or remove a filter to explore more."]</p>
                        @if (activeFilterCount > 0)
                        {
                            <a class="btn btn-outline" href="@clearFiltersUrl">@HtmlLocalizer["Clear all"]</a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script src="~/Scripts/search.js" asp-append-version="true" defer></script>
}
