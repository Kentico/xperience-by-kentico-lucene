@using DancingGoat.Models

@model PaymentShippingViewModel

<h2><span class="step">@(ViewData["Step"] ?? "04")</span>@HtmlLocalizer["Shipping and payment"]</h2>

<div class="form-group" id="shippingGroup">
    <div class="form-group-label">
        @Html.LabelFor(m => m.ShippingMethodId, new { @for = "shippingDropdown" })
    </div>
    <div class="form-group-input select-wrap">
        @Html.DropDownListFor(m => m.ShippingMethodId, Model.Shippings, HtmlLocalizer["Select a shipping method"].Value,
            new { @class = "select", @id = "shippingDropdown", data_storage = $"PaymentShipping_{nameof(PaymentShippingViewModel.ShippingMethod)}" })
    </div>
    <div class="error-label">
        @Html.ValidationMessageFor(m => m.ShippingMethodId)
    </div>
</div>

<div class="form-group">
    <div class="form-group-label">
        @Html.LabelFor(m => m.PaymentMethodId, new { @for = "paymentDropdown" })
    </div>
    <div class="form-group-input select-wrap">
        @Html.DropDownListFor(m => m.PaymentMethodId, Model.Payments, HtmlLocalizer["Select a payment method"].Value,
            new { @class = "select", @id = "paymentDropdown", data_storage = $"PaymentShipping_{nameof(PaymentShippingViewModel.PaymentMethod)}" })
    </div>
    <div class="error-label">
        @Html.ValidationMessageFor(m => m.PaymentMethodId)
    </div>
</div>
