@using DancingGoat.Commerce
@using DancingGoat.Helpers
@using DancingGoat.Models
@using DancingGoat.Services

@using Kentico.Content.Web.Mvc.Routing

@inject WebPageUrlProvider webPageUrlProvider
@inject IPreferredLanguageRetriever currentLanguageRetriever

@model CheckoutViewModel

@{
    var shoppingCartPageUrl = await webPageUrlProvider.ShoppingCartPageUrl();
    var orderSummaryUrl = Url.Action(nameof(DancingGoatCheckoutController.GetOrderSummary), "DancingGoatCheckout", new { languageName = currentLanguageRetriever.Get() });
}

<div class="page-head">
    <div class="wrap">
        <div class="crumb">
            <a href="@shoppingCartPageUrl">&larr; @HtmlLocalizer["Back to shopping cart"]</a>
        </div>
        <h1 class="display">@HeadingFormatter.Format(HtmlLocalizer["Checkout"].Value)</h1>
    </div>
</div>

<section class="block-tight">
    <div class="wrap">
        <form asp-controller="DancingGoatCheckout" method="post" id="checkoutForm" class="cart-layout">
            <div class="checkout-card">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="checkout-section">
                    @Html.EditorFor(m => m.Customer, new { Step = "01" })
                </div>
                <div class="checkout-section">
                    @Html.EditorFor(m => m.BillingAddress, new { Step = "02" })
                </div>
                <div class="checkout-section">
                    @Html.EditorFor(m => m.ShippingAddress, new { Step = "03" })
                </div>
                <div class="checkout-section">
                    @Html.EditorFor(m => m.PaymentShipping, new { Step = "04" })
                </div>
            </div>
            <div class="checkout-right">
                <aside class="summary-card" id="checkoutSummary" data-summary-url="@orderSummaryUrl"
                       data-summary-error="@HtmlLocalizer["The order summary could not be refreshed. The totals below may be out of date."]"
                       data-summary-updated="@HtmlLocalizer["Order summary updated."]">
                    <partial name="_OrderSummaryCard" model='new OrderSummaryViewModel(Model.ShoppingCart, Model.PaymentShipping.ShippingPrice, Model.PaymentShipping.OriginalShippingPrice, Model.PaymentShipping.HasFreeShippingPromotion)' />
                </aside>
                <p class="visually-hidden" id="checkoutSummaryStatus" role="status" aria-live="polite" aria-atomic="true"></p>
                <div class="checkout-place">
                    <input type="submit" class="btn btn-solid btn-block" value="@HtmlLocalizer["Place your order"]" />
                    <p class="place-note">@HtmlLocalizer["Fill in your details to place your order."]</p>
                </div>
            </div>
        </form>
    </div>
</section>
