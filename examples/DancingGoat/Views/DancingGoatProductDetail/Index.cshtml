@using DancingGoat.Helpers
@using CMS.Commerce
@using DancingGoat.Commerce
@using DancingGoat.Models
@using DancingGoat.Services
@using Kentico.Content.Web.Mvc.Routing

@inject IPreferredLanguageRetriever currentLanguageRetriever
@inject WebPageUrlProvider webPageUrlProvider

@model ProductViewModel

@{
    var languageName = currentLanguageRetriever.Get();
    var storePageUrl = await webPageUrlProvider.StorePageUrl(cancellationToken: Context.RequestAborted);
}

<div class="page-head">
    <div class="wrap">
        <div class="crumb">
            <a href="@storePageUrl">&larr; @HtmlLocalizer["Back to store"]</a>
        </div>
        <h1 class="display pd-title">@HeadingFormatter.Format(Model.Name)</h1>
    </div>
</div>

<section class="block-tight">
    <div class="wrap">
        <article class="product-layout">
            <div>
                <div class="pd-media@(Model.IsMerchandise ? " pd-media-fill" : null)">
                    @if (Model.Tag != null)
                    {
                        <div class="card-chips"><span class="chip">@Model.Tag.Title</span></div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Url.Content(Model.ImagePath)" alt="@Model.Name" title="@Model.Name" />
                    }
                </div>

                <div class="prose">
                    <p>
                        @Html.Raw(Model.Description)
                    </p>
                </div>

                @if (Model.Parameters.Count > 0)
                {
                    <div class="params">
                        @foreach (var parameter in Model.Parameters)
                        {
                            <dl>
                                <dt>@parameter.Key</dt>
                                <dd>@parameter.Value</dd>
                            </dl>
                        }
                    </div>
                }
            </div>

            <aside class="pd-aside">
                <div class="buy-card">
                    @{
                        var routeData = new Dictionary<string, string> { { "languageName", languageName } };
                        <form method="post" asp-controller="DancingGoatShoppingCart" asp-action="Add" asp-all-route-data="routeData" data-cart-add-form>
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            @if (Model.Variants?.Count > 0)
                            {
                                <div class="buy-row">
                                    <label class="buy-label" for="variantId">@HtmlLocalizer["Variant"]</label>
                                    <div class="select-wrap">
                                        <select id="variantId" name="variantId" class="select">
                                            @foreach (var variant in Model.Variants)
                                            {
                                                <option value="@variant.Key" data-sku="@(Model.VariantSkus.TryGetValue(variant.Key, out var variantSku) ? variantSku : null)">@variant.Value</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            }
                            <div class="buy-row">
                                <span class="buy-label">@HtmlLocalizer["Unit price"]</span>
                                <div class="buy-price">
                                    @if (Model.HasDiscount)
                                    {
                                        <span class="chip chip-sale">-@Model.AppliedPromotion.PromotionDisplayLabel</span>
                                        <span class="price-old"><price>@Model.ListPrice</price></span>
                                        <span class="price-sale"><price>@Model.Price</price></span>
                                    }
                                    else
                                    {
                                        <price>@Model.Price</price>
                                    }
                                </div>
                            </div>
                            <div class="buy-row">
                                <label class="buy-label" for="quantity">@HtmlLocalizer["Quantity"]</label>
                                <input type="hidden" id="contentItemId" name="contentItemId" value="@Model.ContentItemId" />
                                <div class="qty" data-qty-stepper>
                                    <button type="button" data-qty-step="-1" aria-label="@HtmlLocalizer["Decrease quantity"]">&minus;</button>
                                    <input type="number" id="quantity" name="quantity" value="1" min="1" max="1000" />
                                    <button type="button" data-qty-step="1" aria-label="@HtmlLocalizer["Increase quantity"]">+</button>
                                </div>
                            </div>
                            <button class="btn btn-solid btn-block" type="submit">@HtmlLocalizer["Add to cart"]</button>
                        </form>
                    }
                </div>

                @if (Model.HasSku)
                {
                    <p class="pd-sku" data-product-sku aria-live="polite" hidden="@(string.IsNullOrEmpty(Model.InitialSku))">@Model.InitialSku</p>
                }

                @foreach (var freeShippingPromotion in Model.FreeShippingPromotions)
                {
                    <div class="buy-card free-shipping-card">
                        <div><span class="chip chip-shipping">@HtmlLocalizer["Free shipping"]</span></div>
                        <p class="fs-message">@freeShippingPromotion.Message</p>
                    </div>
                }

                @foreach (var cartItemDiscount in Model.CartItemDiscounts)
                {
                    <div class="buy-card cart-discount-card">
                        <div><span class="chip chip-offer">@HtmlLocalizer["Special offer"]</span></div>
                        <p class="cd-message">@cartItemDiscount.Message</p>
                    </div>
                }
            </aside>
        </article>
    </div>
</section>

@section scripts {
    <script src="~/Scripts/qtyStepper.js" defer></script>
    <script src="~/Scripts/productSku.js" defer></script>
}
