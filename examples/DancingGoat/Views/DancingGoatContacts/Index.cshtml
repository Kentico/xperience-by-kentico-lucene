@using DancingGoat.Helpers

@model DancingGoat.Models.ContactsIndexViewModel

<div class="page-head">
    <div class="wrap">
        <h1 class="display">@HeadingFormatter.Format(HtmlLocalizer["Come say hello"].Value)</h1>
    </div>
</div>

<section class="block-tight">
    <div class="wrap">
        <div class="contact-layout">
            <div>
                <h2 class="display">@HeadingFormatter.Format(HtmlLocalizer["Roastery"].Value)</h2>
                <ul class="info-list">
                    <li>
                        <span class="k">@HtmlLocalizer["Phone"]</span>
                        <span>@Model.CompanyContact.Phone</span>
                    </li>
                    <li>
                        <span class="k">@HtmlLocalizer["Address"]</span>
                        <span>
                            @Model.CompanyContact.Street @Model.CompanyContact.City,<br />
                            @Model.CompanyContact.ZipCode, @Model.CompanyContact.Country
                        </span>
                    </li>
                    @if (!string.IsNullOrEmpty(Model.CompanyContact.Email))
                    {
                        <li>
                            <span class="k">@HtmlLocalizer["Email"]</span>
                            <span><email address="@Model.CompanyContact.Email" /></span>
                        </li>
                    }
                </ul>
            </div>

            <div id="message-form" class="contact-card contact-us-form">
                <editable-area area-identifier="ContactUs" area-options-allowed-widgets="new[] { SystemComponentIdentifiers.FORM_WIDGET_IDENTIFIER }" />
            </div>
        </div>
    </div>
</section>

<section class="block-tight">
    <div class="wrap">
        <div class="section-head">
            <div>
                <h2 class="display">@HeadingFormatter.Format(HtmlLocalizer["Our cafés"].Value)</h2>
            </div>
        </div>
        <div class="cafe-grid no-hover">
            @foreach (var cafe in @Model.CompanyCafes)
            {
                <div class="cafe-card">
                    @if (!string.IsNullOrEmpty(cafe.PhotoPath))
                    {
                        <img src="@Url.Content(cafe.PhotoPath)" alt="@cafe.PhotoShortDescription" title="@cafe.Name" loading="lazy" />
                    }
                    <div class="cafe-label">
                        <div>
                            <h3>@cafe.Name</h3>
                            <div class="hours">@cafe.Street @(string.IsNullOrEmpty(cafe.Phone) ? null : "· " + cafe.Phone)</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
