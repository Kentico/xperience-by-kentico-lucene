@using DancingGoat.Models
@using DancingGoat.Services

@inject WebPageUrlProvider webPageUrlProvider

@model IEnumerable<NavigationItemViewModel>

@{
    var storeUrl = await webPageUrlProvider.StorePageUrl(cancellationToken: Context.RequestAborted);
}

<nav aria-label="@HtmlLocalizer["Product categories"]">
    <ul class="cat-tabs">
        <li>
            <a class="cat-tab" href="@storeUrl" asp-active="@storeUrl">@HtmlLocalizer["Recommended"]</a>
        </li>
    @foreach (var item in Model)
    {
        <li>
            <a class="cat-tab" href="@item.RelativeUrl" asp-active="@item.RelativeUrl">@item.Caption</a>
        </li>
    }
    </ul>
</nav>
