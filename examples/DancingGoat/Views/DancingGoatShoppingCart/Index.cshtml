@using CMS.Websites
@using CMS.Websites.Routing
@using DancingGoat.Helpers
@using DancingGoat.Models
@using DancingGoat.Services
@using Kentico.Content.Web.Mvc.Routing

@inject WebPageUrlProvider webPageUrlProvider

@model ShoppingCartViewModel

@{
    ViewBag.Title = HtmlLocalizer["Shopping cart"].Value;

    var checkoutPageUrl = await webPageUrlProvider.CheckoutPageUrl();
    var storePageUrl = await webPageUrlProvider.StorePageUrl();
}

<div class="page-head">
    <div class="wrap">
        <div class="crumb">
            <a href="@storePageUrl">&larr; @HtmlLocalizer["Continue shopping"]</a>
        </div>
        <h1 class="display">@HeadingFormatter.Format(HtmlLocalizer["Your shopping cart"].Value)</h1>
    </div>
</div>

<section class="block-tight">
    <div class="wrap">
        @if (!Model.Items.Any())
        {
            <div class="empty-cart">
                <h2 class="display">@HeadingFormatter.Format(HtmlLocalizer["Your cart is empty"].Value)</h2>
                <p>@HtmlLocalizer["Shopping cart is empty"]</p>
                <a class="btn btn-solid" href="@storePageUrl">@HtmlLocalizer["Explore the store"] <span class="arrow">&rarr;</span></a>
            </div>
        }
        else
        {
            <div class="cart-layout" data-cart data-cart-error="@HtmlLocalizer["The cart could not be updated. Reload the page to see the current contents."]">
                <div data-cart-lines>
                    <partial name="_ShoppingCartContentEdit" model="Model" />
                </div>

                <aside class="summary-card">
                    <h2 class="summary-title">@HtmlLocalizer["Summary"]</h2>
                    <div id="shoppingCartTotals" data-cart-totals>
                        <partial name="_ShoppingCartTotals" model="Model" />
                    </div>
                    <p class="summary-note">@HtmlLocalizer["Shipping & tax calculated at checkout."]</p>
                    <a class="btn btn-solid btn-block" href="@checkoutPageUrl">@HtmlLocalizer["Proceed to checkout"] <span class="arrow">&rarr;</span></a>
                    <p class="visually-hidden" id="qtyAutoUpdateHint">@HtmlLocalizer["Changing the quantity updates your cart."]</p>
                    <p class="visually-hidden" id="cartStatus" role="status" aria-live="polite" aria-atomic="true"></p>
                </aside>
            </div>
        }
    </div>
</section>

@section scripts {
    <script src="~/Scripts/promotionCode.js" asp-append-version="true" defer></script>
    <script src="~/Scripts/qtyStepper.js" asp-append-version="true" defer></script>
}
