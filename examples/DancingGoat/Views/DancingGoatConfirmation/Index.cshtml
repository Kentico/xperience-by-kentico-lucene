@model DancingGoat.Models.ConfirmationPageViewModel

@using DancingGoat.Helpers
@using System.Linq;

<div class="page-head">
    <div class="wrap">
        <h1 class="display">@HeadingFormatter.Format(Model.Header)</h1>
        <div class="prose page-content">
            @Html.Raw(Model.Content)
        </div>
    </div>
</div>

@if (Model.ArticlesSection != null)
{
    <vc:articles articles-section-item="@Model.ArticlesSection" />
}
