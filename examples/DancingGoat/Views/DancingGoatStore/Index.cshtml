@using DancingGoat.Helpers
@using DancingGoat.Models

@model StoreViewModel

<div class="page-head">
    <div class="wrap">
        <h1 class="display">@HeadingFormatter.Format(HtmlLocalizer["The Dancing Goat store"].Value)</h1>
        <p class="lede">@HtmlLocalizer["Everything we brew with at our cafés."]</p>
        @Html.DisplayFor(m => @Model.CategoryMenuViewModel, "ProductCategoryMenu")
    </div>
</div>

<div id="product-list">
    @foreach (var productList in Model?.SelectionProductList ?? [])
    {
        <section class="block-tight">
            <div class="wrap">
                <partial name="ProductsList" model="@productList" />
            </div>
        </section>
    }
</div>
