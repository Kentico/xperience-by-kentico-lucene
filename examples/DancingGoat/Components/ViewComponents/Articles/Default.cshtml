@using System.Linq
@using DancingGoat.Helpers
@using DancingGoat.Models;

@model ArticlesSectionViewModel

@{
    var articles = Model.Articles.ToList();
    var feature = articles.Count > 0 ? ArticleTileViewModel.GetViewModel(articles[0]) : null;
    var rest = articles.Skip(1).Select(article => ArticleTileViewModel.GetViewModel(article)).ToList();
}

<section class="block">
    <div class="wrap">
        <div class="section-head reveal">
            <div>
                <h2 class="display">@HeadingFormatter.Format(HtmlLocalizer["Latest articles"].Value)</h2>
            </div>
            <a class="section-link" href="@Model.ArticlesPath">@HtmlLocalizer["More articles"] &rarr;</a>
        </div>

        @if (feature != null)
        {
            var featureIsLocked = feature.IsSecured && !User.Identity.IsAuthenticated;

            <article class="article-feature reveal">
                <a class="ac-overlay" href="@feature.Url" aria-label="@feature.Title"></a>
                <div class="media">
                    @if (featureIsLocked)
                    {
                        <div class="card-chips"><span class="chip">@HtmlLocalizer["Members only"]</span></div>
                    }
                    @if (!string.IsNullOrEmpty(feature.TeaserUrl))
                    {
                        <img src="@Url.Content(feature.TeaserUrl)" alt="" loading="lazy" />
                    }
                </div>
                <div>
                    <span class="article-date">@feature.PublicationDate?.ToString("M")</span>
                    <h3 class="display">@HeadingFormatter.Format(feature.Title)</h3>
                    <p class="summary">@feature.Summary</p>
                    @if (featureIsLocked)
                    {
                        <p class="locked-note">@HtmlLocalizer["Sign in to read this article"] &rarr;</p>
                    }
                    else
                    {
                        <span class="read-more">@HtmlLocalizer["Read the article"]</span>
                    }
                </div>
            </article>
        }

        @if (rest.Count > 0)
        {
            <div class="article-grid">
                @foreach (var tile in rest)
                {
                    <partial name="_ArticleTile" model="tile" />
                }
            </div>
        }
    </div>
</section>
