@using DancingGoat.Models

@model NavigationMenuViewModel

<ul class="nav-links" id="nav-links">
    @foreach (var navigationItem in Model.Items)
    {
        var isActive = Model.ActivePath != null && navigationItem.ResolvedPath.Equals(Model.ActivePath, StringComparison.InvariantCultureIgnoreCase);
        <li>
            <a href="@navigationItem.RelativeUrl" class="@(isActive ? "active" : null)">@HtmlLocalizer[navigationItem.Caption]</a>
        </li>
    }
</ul>
