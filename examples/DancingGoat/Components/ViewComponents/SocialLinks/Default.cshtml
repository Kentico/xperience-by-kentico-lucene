@model IEnumerable<DancingGoat.Models.SocialLinkViewModel>

<div class="social-row">
    @foreach (var link in Model)
    {
        <a href="@link.Url" target="_blank" rel="noopener" aria-label="@link.Title" title="@link.Title">
            <img src="@Url.Content(link.IconPath)" alt="" loading="lazy" />
        </a>
    }
</div>
