@using DancingGoat.Models
@model CafeViewModel

@if (String.IsNullOrEmpty(Model.Name) && string.IsNullOrEmpty(Model.PhotoPath))
{
    <h2>@HtmlLocalizer["No cafe selected"]</h2>
}
else
{
    @if (!string.IsNullOrEmpty(Model.PhotoPath))
    {
        <img src="@Url.Content(Model.PhotoPath)" alt="@Model.PhotoShortDescription" title="@Model.Name" loading="lazy" />
    }
    <div class="cafe-label">
        <div>
            <h3>@Model.Name</h3>
            <div class="hours">@Model.Street @(string.IsNullOrEmpty(Model.Phone) ? null : "· " + Model.Phone)</div>
        </div>
        <span class="cafe-go">&rarr;</span>
    </div>
}
