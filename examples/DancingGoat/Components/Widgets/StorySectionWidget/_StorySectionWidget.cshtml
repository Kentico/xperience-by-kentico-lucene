@using DancingGoat.Helpers
@using DancingGoat.Models

@model DancingGoat.Widgets.StorySectionWidgetViewModel

@inject Kentico.Builder.Web.Mvc.IAdminBuildersLocalizationService localizationService

@if (Model == null)
{
    @if (Context.Kentico().PageBuilder().EditMode)
    {
        <h3 class="grid-empty">
            @localizationService.LocalizeString("{$dancinggoat.storysectionwidget.selectstorysection$}")
        </h3>
    }
}
else
{
    <section class="block">
        <div class="wrap">
            <div class="section-head reveal">
                <div>
                    <ai-scope origin="@Model.GetAiProvenanceOrigin(nameof(StorySection.StorySectionTitle))" label-position="After">
                        <h2 class="display">@HeadingFormatter.Format(Model.Title)</h2>
                    </ai-scope>
                </div>
            </div>
            <div class="story-band reveal">
                <div class="grain"></div>
                <div class="story-inner">
                    <ai-scope origin="@Model.GetAiProvenanceOrigin(nameof(StorySection.StorySectionText))" label-position="After" on-dark-surface="true">
                        <p class="display">@Model.Text</p>
                    </ai-scope>
                </div>
            </div>
        </div>
    </section>
}
