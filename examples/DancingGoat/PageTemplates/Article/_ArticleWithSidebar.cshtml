@using DancingGoat.Helpers
@using DancingGoat.PageTemplates
@using DancingGoat.Widgets
@using DancingGoat.Models
@using DancingGoat.Services

@inject WebPageUrlProvider webPageUrlProvider

@model TemplateViewModel

@{
    Layout = "~/Views/Shared/_DancingGoatLayout.cshtml";
    var templateModel = Model.GetTemplateModel<ArticleDetailViewModel>();

    var articlesPath = await webPageUrlProvider.ArticlesPageUrl();
}

<div class="page-head">
    <div class="wrap">
        <div class="crumb">
            <a href="@articlesPath">&larr; @HtmlLocalizer["Back to articles"]</a>
        </div>
        <div class="article-hero">
            @if (!string.IsNullOrEmpty(templateModel.TeaserUrl))
            {
                <div class="media">
                    <img src="@Url.Content(templateModel.TeaserUrl)" alt="@templateModel.Title" title="@templateModel.Title" loading="lazy" />
                </div>
            }
            <div>
                <span class="date-line">@templateModel.PublicationDate.ToString("D")</span>
                <ai-scope origin="@templateModel.GetAiProvenanceOrigin(nameof(ArticlePage.ArticleTitle))" label-position="After">
                    <h1 class="display">@HeadingFormatter.Format(templateModel.Title)</h1>
                </ai-scope>
                @if (!string.IsNullOrEmpty(templateModel.Summary))
                {
                    <ai-scope origin="@templateModel.GetAiProvenanceOrigin(nameof(ArticlePage.ArticlePageSummary))" label-position="After">
                        <p class="lede">@templateModel.Summary</p>
                    </ai-scope>
                }
            </div>
        </div>
    </div>
</div>

<section class="block-tight">
    <div class="wrap">
        <div class="article-layout">
            <div class="article-main">
                <ai-scope origin="@templateModel.GetAiProvenanceOrigin(nameof(ArticlePage.ArticlePageText))">
                    <div class="prose">
                        @Html.Kentico().ResolveUrls(templateModel.Text)
                    </div>
                </ai-scope>
            </div>
            <aside class="article-side">
                <editable-area area-identifier="sidebar"
                               area-options-allowed-widgets="new[] { SystemComponentIdentifiers.RICH_TEXT_WIDGET_IDENTIFIER, ComponentIdentifiers.CTA_BUTTON_WIDGET, StorySectionWidgetViewComponent.IDENTIFIER }" />
            </aside>
        </div>
    </div>
</section>
