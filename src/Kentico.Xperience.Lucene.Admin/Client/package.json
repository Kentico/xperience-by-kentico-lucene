{
  "name": "kentico-lucene-web-admin",
  "version": "15.0.0",
  "description": "Xperience by Kentico Lucene administration project.",
  "private": true,
  "scripts": {
    "start": "npm run lint && webpack serve --mode development",
    "build:dev": "npm run lint && webpack --mode=development",
    "build": "npm run lint && webpack --mode=production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@kentico/xperience-admin-base": "31.0.0",
    "@kentico/xperience-admin-components": "31.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.5.0",
    "react-tooltip": "5.29.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/eslint-parser": "7.29.13",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/preset-env": "7.29.14",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@kentico/xperience-webpack-config": "31.0.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "babel-loader": "10.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "globals": "16.5.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "webpack": "5.112.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.7"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react"
  },
  "browserslist": [
    "> .2% and last 3 versions",
    "not op_mini all",
    "not IE 11"
  ]
}
